{
  "name": "cuibaponline-github-io",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:all": "npm run build -- animal-learning",
    "build:animal-learning": "ng build animal-learning --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
